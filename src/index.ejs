<!DOCTYPE html>
<html lang="es">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <% if (!process.env.IS_ELECTRON) { %>
    <meta name="description" content="Yutu Premium: videos sin anuncios ni rastreo, con interfaz estilo YouTube." />
    <meta name="theme-color" content="#0f0f0f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Yutu Premium" />
    <link rel="manifest" href="static/manifest.json" />
    <script>
    // App de Android TV (el APK añade "YutuTV" al user agent): modo control remoto
    if (/YutuTV/.test(navigator.userAgent)) {
      document.documentElement.classList.add("yutu-tv");
    }
    </script>
    <script>
    // iPhone en modo app: si el sistema no informa la zona reservada (hora/isla dinámica), se reserva a mano
    (function () {
      var ua = navigator.userAgent;
      var ios = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
      var standalone = navigator.standalone === true || (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches);
      if (!ios || !standalone) return;
      var probe = document.createElement("div");
      probe.style.cssText = "position:fixed;top:0;left:0;width:1px;padding-top:env(safe-area-inset-top,0px);visibility:hidden";
      document.documentElement.appendChild(probe);
      var measured = probe.getBoundingClientRect().height;
      document.documentElement.removeChild(probe);
      if (measured >= 20) return;
      var h = Math.max(screen.height, screen.width);
      var root = document.documentElement.style;
      root.setProperty("--yt-safe-top", (h >= 852 ? 59 : h >= 812 ? 47 : 20) + "px");
      root.setProperty("--yt-safe-bottom", (h >= 812 ? 34 : 0) + "px");
    })();
    </script>
    <link rel="icon" type="image/svg+xml" href="static/icons/logo.svg" />
    <link rel="apple-touch-icon" href="static/icons/apple-touch-icon.png" />
    <% } %>
    <title>Yutu Premium</title>
  </head>

  <body>
    <div id="app"></div>
    <% if (process.env.IS_ELECTRON) { %>
    <iframe
      id="sigFrame"
      src="<%= sigFrameSrc %>"
      csp="default-src 'none'; script-src '<%= sigFrameCspHash %>' 'unsafe-eval'"
      sandbox="allow-scripts"
      height="1"
      width="1"
      style="display: none; pointer-events: none"
      tabindex="-1"
    ></iframe>
    <% } else { %>
    <script>
    // Service worker con auto-actualización: se revisa al abrir, al volver a la app y cada 45 min
    if ("serviceWorker" in navigator) {
      var hadController = !!navigator.serviceWorker.controller;
      var reloaded = false;
      var pendingReload = false;
      function reloadWhenIdle() {
        var playing = Array.prototype.some.call(document.querySelectorAll('audio, video'), function (media) {
          return !media.paused && !media.ended;
        });
        if (playing || reloaded) return;
        reloaded = true;
        window.location.reload();
      }
      document.addEventListener('pause', function () {
        if (pendingReload) window.setTimeout(reloadWhenIdle, 0);
      }, true);
      navigator.serviceWorker.addEventListener("controllerchange", function () {
        if (!hadController || reloaded) { hadController = true; return; }
        pendingReload = true;
        reloadWhenIdle();
      });
      navigator.serviceWorker.register("pwabuilder-sw.js", { scope: "./", updateViaCache: "none" }).then(function (reg) {
        var check = function () { reg.update().catch(function () {}); };
        document.addEventListener("visibilitychange", function () { if (document.visibilityState === "visible") check(); });
        setInterval(check, 45 * 60 * 1000);
      }).catch(function () {});
    }
    </script>
    <% } %>
    <!-- webpack builds are automatically injected -->
  </body>

</html>
